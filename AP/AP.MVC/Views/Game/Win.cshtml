@using AP.Models.Entities

@{
    ViewBag.Title = "¡Victoria!";

    var game = Session["Game"] as GameState;
}

<style>

    body {
        background: linear-gradient(135deg,#0f172a,#1e293b);
    }

    .win-card {
        max-width: 700px;
        margin: 70px auto;
        background: white;
        border-radius: 30px;
        padding: 50px;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0,0,0,.45);
    }

    .trophy {
        font-size: 90px;
        animation: pulse 1.8s infinite;
    }

    @@keyframes pulse {

        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.12);
        }

        100% {
            transform: scale(1);
        }
    }

    .title {
        font-size: 55px;
        font-weight: bold;
        color: #16a34a;
        margin-top: 15px;
    }

    .subtitle {
        font-size: 22px;
        color: #555;
        margin: 25px 0;
    }

    .info {
        font-size: 30px;
        color: #2563eb;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .buttons {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 35px;
    }

    .btn-custom {
        padding: 18px 35px;
        border-radius: 15px;
        text-decoration: none;
        color: white;
        font-size: 20px;
        transition: .3s;
    }

    .play {
        background: #16a34a;
    }

    .home {
        background: #2563eb;
    }

    .btn-custom:hover {
        transform: translateY(-5px);
        color: white;
    }
</style>

<div class="win-card">

    <div class="trophy">
        🏆
    </div>

    <div class="title">
        ¡GANASTE!
    </div>

    <div class="subtitle">

        ¡Felicidades!<br />

        Has completado los <strong>15 niveles</strong> de Math Puzzle.

    </div>

    <div class="info">

        ⭐ Puntuación Final: @(game?.Score ?? 0)

    </div>

    <div class="info">

        🎯 Nivel Alcanzado: @(game?.Level ?? 15)

    </div>

    <div class="info">

        ❤️ Vidas Restantes: @(game?.Hearts ?? "🤍 🤍 🤍")

    </div>

    <div class="buttons">

        @Html.ActionLink(
            "🔄 Jugar de nuevo",
            "NewGame",
            "Game",
            null,
            new { @class = "btn-custom play" })

        @Html.ActionLink(
            "🏠 Inicio",
            "Index",
            "Home",
            null,
            new { @class = "btn-custom home" })

    </div>

</div>