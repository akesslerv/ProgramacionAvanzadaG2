@model AP.Models.Entities.GameState

@{
    ViewBag.Title = "Jugar";
}

<style>

    @@keyframes aparecer {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .game-card {
        max-width: 700px;
        margin: auto;
        background: white;
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 15px 40px rgba(0,0,0,.30);
        animation: aparecer .5s ease;
    }

    .game-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 20px;
        font-size: 22px;
        font-weight: bold;
    }

    .question-box {
        background: #eef4ff;
        border-radius: 20px;
        padding: 25px;
        margin: 30px 0;
    }

    .question {
        text-align: center;
        font-size: 38px;
        font-weight: bold;
        color: #1e3a8a;
    }

    .answer {
        display: block;
        width: 100%;
        border: none;
        border-radius: 15px;
        padding: 22px;
        font-size: 22px;
        margin-bottom: 20px;
        color: white;
        cursor: pointer;
        transition: all .25s ease;
    }

        .answer:hover {
            transform: translateY(-5px) scale(1.03);
            box-shadow: 0 10px 25px rgba(0,0,0,.35);
        }

    .blue {
        background: #2563eb;
    }

    .green {
        background: #16a34a;
    }

    .yellow {
        background: #f59e0b;
    }

    .purple {
        background: #8b5cf6;
    }
</style>

<div class="game-card">

    <!-- Vidas y puntos -->
    <div class="game-header">

        <div>
            @Model.Hearts
        </div>

        <div>
            ⭐ @Model.Score
        </div>

    </div>

    <!-- Nivel y tiempo -->
    <div class="game-header">

        <div>
            Nivel @Model.Level
        </div>

        <div id="timer">
            ⏱ 30 s
        </div>

    </div>

    <!-- Barra de progreso -->
    @{
        int progress = (int)Math.Round((Model.Level / 15.0) * 100);
    }

    <div class="progress mb-4">

        <div class="progress-bar bg-success d-flex align-items-center justify-content-center"
             role="progressbar"
             style="width:@progress%;"
             aria-valuenow="@progress"
             aria-valuemin="0"
             aria-valuemax="100">

            @progress%

        </div>

    </div>

    <!-- Pregunta -->
    <div class="question-box">

        <div class="question">
            @Model.CurrentQuestion.Question
        </div>

    </div>

    <!-- Respuestas -->
    @using (Html.BeginForm("Answer", "Game", FormMethod.Post))
    {
        <button type="submit"
                name="selectedAnswer"
                value="@Model.CurrentQuestion.OptionA"
                class="answer blue answer-btn">
            @Model.CurrentQuestion.OptionA
        </button>

        <button type="submit"
                name="selectedAnswer"
                value="@Model.CurrentQuestion.OptionB"
                class="answer green answer-btn">
            @Model.CurrentQuestion.OptionB
        </button>

        <button type="submit"
                name="selectedAnswer"
                value="@Model.CurrentQuestion.OptionC"
                class="answer yellow answer-btn">
            @Model.CurrentQuestion.OptionC
        </button>

        <button type="submit"
                name="selectedAnswer"
                value="@Model.CurrentQuestion.OptionD"
                class="answer purple answer-btn">
            @Model.CurrentQuestion.OptionD
        </button>
    }

    <!-- Formulario oculto para cuando se acaba el tiempo -->
    @using (Html.BeginForm("Answer", "Game", FormMethod.Post, new { id = "timeoutForm" }))
    {
        <input type="hidden"
               name="selectedAnswer"
               value="__TIMEOUT__" />
    }

</div>

<script>

    let timeLeft = 30;

    const timer = document.getElementById("timer");
    const answerButtons = document.querySelectorAll(".answer-btn");

    let answered = false;

    answerButtons.forEach(function (button) {

        button.addEventListener("click", function () {

            if (answered)
                return;

            answered = true;

            clearInterval(countdown);

        });

    });

    const countdown = setInterval(function () {

        if (answered)
            return;

        timeLeft--;

        if (timeLeft <= 5) {
            timer.style.color = "red";
        }
        else if (timeLeft <= 10) {
            timer.style.color = "orange";
        }
        else {
            timer.style.color = "";
        }

        timer.innerHTML = "⏱ " + timeLeft + " s";

        if (timeLeft <= 0) {

            answered = true;

            clearInterval(countdown);

            answerButtons.forEach(function (btn) {
                btn.disabled = true;
            });

            timer.innerHTML = "⏰ Tiempo agotado";

            setTimeout(function () {

                document.getElementById("timeoutForm").submit();

            }, 700);

        }

    }, 1000);

</script>