@{
    ViewBag.Title = "Inicio";
}

<style>

    .hero {
        text-align: center;
        color: white;
        margin-top: 40px;
    }

        .hero h1 {
            font-size: 60px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 22px;
            color: #dbeafe;
            margin-bottom: 40px;
        }

    .menu-card {
        border-radius: 25px;
        padding: 25px;
        margin-bottom: 25px;
        text-align: center;
        transition: .35s;
        box-shadow: 0 10px 20px rgba(0,0,0,.25);
        cursor: pointer;
    }

        .menu-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 18px 35px rgba(0,0,0,.45);
        }

    .play {
        background: linear-gradient(135deg,#22c55e,#16a34a);
    }

    .ranking {
        background: linear-gradient(135deg,#fb923c,#ea580c);
    }

    .profile {
        background: linear-gradient(135deg,#8b5cf6,#6d28d9);
    }

    .menu-card a {
        color: white !important;
        text-decoration: none;
        font-size: 30px;
        font-weight: bold;
    }

    .icon {
        font-size: 50px;
        margin-bottom: 15px;
    }
</style>

<div class="hero">

    <div class="icon">
        🧠
    </div>

    <h1>Math Puzzle</h1>

    <p>
        Pon a prueba tu lógica matemática y supera todos los desafíos.
    </p>

</div>

<div class="row mt-5">

    <!-- JUGAR -->
    <div class="col-md-6">

        <a href="@Url.Action("Index", "Game")"
           style="text-decoration:none;">

            <div class="menu-card play">

                <div class="icon">
                    🎮
                </div>

                <span style="color:white;
                             font-size:30px;
                             font-weight:bold;">
                    Jugar
                </span>

            </div>

        </a>

    </div>

    <!-- RANKING -->
    <div class="col-md-6">

        <a href="@Url.Action("Index", "Ranking")"
           style="text-decoration:none;">

            <div class="menu-card ranking">

                <div class="icon">
                    🏆
                </div>

                <span style="color:white;
                             font-size:30px;
                             font-weight:bold;">
                    Ranking
                </span>

            </div>

        </a>

    </div>

    <!-- PERFIL -->
    <div class="col-md-6 offset-md-3">

        <a href="@Url.Action("Index", "Profile")"
           style="text-decoration:none;">

            <div class="menu-card profile">

                <div class="icon">
                    👤
                </div>

                <span style="color:white;
                             font-size:30px;
                             font-weight:bold;">
                    Perfil
                </span>

            </div>

        </a>

    </div>

</div>