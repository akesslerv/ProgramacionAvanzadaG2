@model List<AP.Models.Entities.RankingViewModel>

@{
    ViewBag.Title = "Ranking Optimizado";
}

<style>

    .ranking-card {
        max-width: 800px;
        margin: auto;
        background: white;
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 15px 35px rgba(0,0,0,.25);
    }

    .title {
        text-align: center;
        font-size: 42px;
        font-weight: bold;
        color: #1e3a8a;
        margin-bottom: 35px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #2563eb;
        color: white;
        padding: 15px;
        text-align: center;
        font-size: 20px;
    }

    td {
        padding: 18px;
        text-align: center;
        font-size: 20px;
        border-bottom: 1px solid #ddd;
    }

    tr:hover {
        background: #eef4ff;
    }

    .back {
        margin-top: 35px;
        text-align: center;
    }

    .btn-home {
        background: #2563eb;
        color: white;
        padding: 15px 35px;
        border-radius: 15px;
        text-decoration: text-decoration;
        font-size: 20px;
        transition: .3s;
    }

        .btn-home:hover {
            background: #1d4ed8;
            color: white;
        }
</style>


<div class="ranking-card">

    <div class="title">
        🏆 Ranking Optimizado
    </div>


    <table>

        <tr>

            <th>🏆</th>
            <th>Jugador</th>
            <th>⭐ Puntos</th>
            <th>🎯 Nivel</th>
            <th>❤️ Vidas</th>

        </tr>


        @{
            int posicion = 1;
        }


        @foreach (var score in Model)
        {

            <tr>

                <td>

                    @if (posicion == 1)
                    {
                        @:🥇
                    }
                    else if (posicion == 2)
                    {
                        @:🥈
                    }
                    else if (posicion == 3)
                    {
                        @:🥉
                    }
                    else
                    {
                        @posicion
                    }

                </td>


                <td>
                    @score.PlayerName
                </td>


                <td>
                    @score.TotalScore
                </td>


                <td>
                    @score.ReachedLevel
                </td>


                <td>

                    @for (int i = 0; i < score.RemainingLives; i++)
                    {
                        @:❤️
                    }

                </td>


            </tr>


            posicion++;

        }


    </table>


    <div class="back">

        @Html.ActionLink(
            "← Volver al Ranking",
            "Index",
            "Ranking",
            null,
            new { @class = "btn-home" })

    </div>


</div>